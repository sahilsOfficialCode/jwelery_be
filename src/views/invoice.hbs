{{!-- views/invoice.hbs --}}
<div class="max-w-4xl mx-auto my-8 bg-white p-8 shadow-md">
  {{!-- logo --}}
  <div class="flex items-center gap-4">
    {{!-- <img src="{{logoUrl}}" alt="Logo" class="h-20 w-auto object-contain"> --}}
  </div>
  <!-- Header -->
  <div class="flex justify-between items-center border-b pb-4 mb-4">
    <div>
      <h1 class="text-2xl font-bold text-gray-800">INVOICE</h1>
      <p class="text-gray-500 text-sm">Invoice Date: {{invoiceDate}}</p>
      <p class="text-gray-500 text-sm">Invoice #: {{invoiceNumber}}</p>
    </div>
    <div class="text-right">
      <img src="{{logoUrl}}" alt="Company Logo" class="h-13 w-auto inline-block">
      <p class="text-gray-500 text-sm">{{companyAddress}}</p>
      <p class="text-gray-500 text-sm">{{companyEmail}}</p>
      <p class="text-gray-500 text-sm">{{companyPhone}}</p>
    </div>
  </div>

  <!-- Billing & Shipping -->
  <div class="flex justify-between mb-6">
    <div>
      <h3 class="font-semibold text-gray-700 mb-1">Billing Details</h3>
      <p class="text-gray-600">{{billingName}}</p>
      <p class="text-gray-600">{{billingAddress}}</p>
      <p class="text-gray-600">{{billingCity}}, {{billingState}} - {{billingZip}}</p>
    </div>
    <div>
      <h3 class="font-semibold text-gray-700 mb-1">Shipping Details</h3>
      <p class="text-gray-600">{{shippingName}}</p>
      <p class="text-gray-600">{{shippingAddress}}</p>
      <p class="text-gray-600">{{shippingCity}}, {{shippingState}} - {{shippingZip}}</p>
    </div>
  </div>
  <!-- Table of items -->
  <table class="w-full text-left border border-gray-200 mb-6">
    <thead>
      <tr class="bg-[#844428] text-white">
        <th class="p-2 border-b">Description</th>
        <th class="p-2 border-b">Qty</th>
        <th class="p-2 border-b">Unit Price</th>
        <th class="p-2 border-b">Subtotal</th>
      </tr>
    </thead>
    <tbody>
      {{#each items}}
      <tr class="border-b">
        <td class="p-2">{{this.description}}</td>
        <td class="p-2">{{this.qty}}</td>
        <td class="p-2">₹ {{this.unitPrice}}</td>
        <td class="p-2">₹ {{this.subtotal}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <!-- Summary -->
  <div class="flex justify-end mb-6">
    <div class="w-1/3">
      <div class="flex justify-between mb-1">
        <span class="text-gray-600">Subtotal:</span>
        <span>₹ {{subtotal}}</span>
      </div>
      <div class="flex justify-between mb-1">
        <span class="text-gray-600">Delivery Charge:</span>
        <span>
          {{#if shipping_charge}}
          ₹ {{shipping_charge}}
          {{else}}
          Free
          {{/if}}
        </span>
      </div>
       <div class="flex justify-between mb-1">
        <span class="text-gray-600">CGST 1.5%:</span>
        <span>₹ 00</span>
      </div>
       <div class="flex justify-between mb-1">
        <span class="text-gray-600">SGST 1.5%:</span>
        <span>₹ 00</span>
      </div>
       <div class="flex justify-between mb-1">
        <span class="text-gray-600">GST:</span>
        <span>₹ 00 </span>
      </div>
      <div class="flex justify-between mb-1 font-bold">
        <span>Total:</span>
        <span>₹ {{total}}</span>
      </div>
    </div>
  </div>

  <!-- Footer -->
  <p class="text-gray-500 text-sm border-t pt-4">This is a computer-generated invoice and does not require a signature.
  </p>
  <p class="text-center text-gray-700 mt-4 font-semibold">★ Thank you for your purchase ★</p>
  <div class="flex justify-between p-8 my-12 pt-4 mt-6 text-gray-600 text-sm">
    <div>
      <p>MYSTIAURA</p>
      <p>https://www.mystiaura.net/</p>
      <p>mystiaurahelp@gmail.com</p>
      <p>{{companyPhone}}</p>
    </div>
    {{!-- <div>
      <p>company name</p>
      <p>GSTIN: </p>
      <p>Website:</p>
      <p>Support: </p>
    </div> --}}
  </div>
</div>